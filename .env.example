MS_AUTH_MODE=device_code
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_SHARED_FOLDER_URL=
MS_TOKEN_CACHE_FILE=.auth/msal_token_cache.json

OCI_AUTH_MODE=config_file
OCI_CONFIG_FILE=C:\Users\YOUR_WINDOWS_USER\.oci\config
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=lease-poc-documents
OCI_OBJECT_PREFIX=inbound/onedrive

MODE=list
SKIP_UNCHANGED=true
MAX_FILES=0
LOG_LEVEL=INFO
